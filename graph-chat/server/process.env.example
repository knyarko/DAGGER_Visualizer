# Copy to .env, in this same folder, and fill in only the providers you use.
# The service loads it at startup and prints the NAMES it loaded, never a value.
#
# A variable already exported in your shell wins over this file.
#
# Never commit a filled-in .env. The repo root .gitignore already ignores
# `.env`, and no code in graph-chat/ reads a key from anywhere but the
# environment.

# --- model providers: set only what you use ---
OPENAI_API_KEY="YOUR_KEY_HERE"
GEMINI_API_KEY="YOUR_KEY_HERE"
LLAMA_API_KEY="NO_KEY_HERE"
ANTHROPIC_API_KEY="YOUR_KEY_HERE"

# Local Llama. No key. Defaults to the local daemon when unset.
OLLAMA_HOST=http://127.0.0.1:11434

# --- service ---
GRAPH_CHAT_PORT=3002
GRAPH_CHAT_DB=
GRAPH_CHAT_ALLOWED_ORIGIN=*
# VITE_GRAPH_CHAT_URL=http://localhost:3010 # Only if 3002 is being used already.
